{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestrictedReadOnlyStorage",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::secure-internal-bucket/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalOrgID": "o-abcdef1234"
        }
      }
    }
  ]
}
